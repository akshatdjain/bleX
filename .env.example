# Example Amazon Q Configuration
# Copy this file to .env and fill in your AWS credentials

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-2
BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-2:YOUR_ACCOUNT_ID:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ── BleX Cloud API (api/ + docker-compose.yml) ──
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/asset_tracking
SECRET_KEY=
REDIS_URL=redis://redis:6379
# MQTT (if API publishes/subscribes)
MQTT_USERNAME=
MQTT_PASSWORD=
TENANT_ID=
