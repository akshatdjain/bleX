[Unit]
OnFailure=blex-sage@%n.service
Description=BleX Provisioner (always runs — waits for app to push config)
After=network-online.target blex-mode.service
Wants=network-online.target blex-discovery.service

[Service]
Type=simple
User=blex
WorkingDirectory=/home/blex/Desktop/blex/scanner
ExecStart=/usr/bin/python3 provisioner_service.py
ExecStopPost=/usr/bin/python3 -c "import sys,os; sys.path.insert(0,'/home/blex/Desktop/blex'); from cypher import get_logger; get_logger('systemd').warning('%n stopped: '+os.environ.get('SERVICE_RESULT','?'))"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
