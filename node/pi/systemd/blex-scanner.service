[Unit]
OnFailure=blex-sage@%n.service
Description=BleX Scanner (runs in both local and cloud mode)
After=network-online.target blex-mode.service blex-master.service
Wants=network-online.target
ConditionPathExists=!/run/blex/unprovisioned

[Service]
Type=simple
User=root
WorkingDirectory=/home/blex/Desktop/blex/scanner
ExecStartPre=-/usr/sbin/rfkill unblock all
ExecStartPre=-/usr/bin/bluetoothctl power on
ExecStartPre=/bin/sleep 10
ExecStartPre=+/bin/sh -c 'mkdir -p /home/blex/Desktop/blex/logs && chown blex:blex /home/blex/Desktop/blex/logs && touch /home/blex/Desktop/blex/logs/blex.log && chown blex:blex /home/blex/Desktop/blex/logs/blex.log && chmod 664 /home/blex/Desktop/blex/logs/blex.log'
ExecStart=/usr/bin/python3 scanner_boot.py
ExecStopPost=/usr/bin/python3 -c "import sys,os; sys.path.insert(0,'/home/blex/Desktop/blex'); from cypher import get_logger; get_logger('systemd').warning('%n stopped: '+os.environ.get('SERVICE_RESULT','?'))"
KillMode=control-group
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
