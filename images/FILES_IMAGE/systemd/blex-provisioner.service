[Unit]
Description=BleX Provisioner (always runs — waits for app to push config)
After=network-online.target blex-mode.service
Wants=network-online.target

[Service]
Type=simple
User=blex
WorkingDirectory=/home/blex/Desktop/blex/scanner
ExecStart=/usr/bin/python3 provisioner_service.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
